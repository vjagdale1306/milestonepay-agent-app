# PayPal Sandbox Configuration
# Your PayPal REST API Sandbox App Client ID
PAYPAL_CLIENT_ID=
# Your PayPal REST API Sandbox App Client Secret
PAYPAL_CLIENT_SECRET=
# PayPal REST API endpoint (defaults to https://api-m.sandbox.paypal.com)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Google Gemini API Configuration
# Google AI Studio API key (GEMINI_API_KEY is also accepted as an alias)
LLM_API_KEY=
# Primary Gemini model ID (defaults to gemini-3.6-flash if omitted)
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback Gemini model ID tried when the primary model is overloaded
GEMINI_FALLBACK_MODEL=

# Backend Server Configuration
# Express HTTP server port (defaults to 5000 if omitted)
PORT=5000
# Optional custom path to SQLite database file (defaults to server/data/milestonepay.db)
DB_PATH=
